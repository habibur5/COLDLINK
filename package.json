{
  "name": "coldlink",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{cjs,mjs,js,ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{cjs,mjs,js,ts,tsx,json}\""
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
