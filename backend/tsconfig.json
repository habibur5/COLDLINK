{
  "compilerOptions": {
    /* Target & Modules */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",

    /* Decorator Support (Required for MikroORM & class-validator) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Type Checking & Interop */
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictPropertyInitialization": false,

    /* Source Maps & Declarations */
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}