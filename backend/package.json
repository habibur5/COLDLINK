{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "imports": {
    "#modules/*": "./src/modules/*",
    "#config/*": "./src/config/*",
    "#database/*": "./src/shared/database/*",
    "#utils/*": "./src/shared/utils/*",
    "#middlewares/*": "./src/shared/middlewares/*",
    "#errors/*": "./src/shared/errors/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:check": "mikro-orm migration:check"
  },
  "mikro-orm": {
    "useTsNode": false,
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/mariadb": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/mysql": "^7.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@mikro-orm/decorators@7.2.0": true,
    "@mikro-orm/mariadb@7.2.0": true
  }
}
